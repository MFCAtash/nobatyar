{
  "uid": "nobatyar-slo",
  "title": "نوبتیار — SLO و مرکز فرمان",
  "tags": ["nobatyar", "slo", "sre"],
  "timezone": "Asia/Tehran",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      { "name": "job", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": "label_values(up, job)", "refresh": 1, "includeAll": true, "multi": true }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "دسترسپذیری ۳۰ روزه (SLO ۹۹٫۹٪)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "100 * (1 - sum(rate(nobatyar_http_requests_total{status=~\"5..\"}[30d])) / clamp_min(sum(rate(nobatyar_http_requests_total[30d])), 0.001))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 99, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 99 }, { "color": "green", "value": 99.9 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2, "type": "timeseries", "title": "نرخ خطای ۵xx و burn rate",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(rate(nobatyar_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(nobatyar_http_requests_total[5m])), 0.001)", "legendFormat": "error rate", "refId": "A" },
        { "expr": "0.001", "legendFormat": "SLO budget (0.1%)", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 3, "type": "timeseries", "title": "تأخیر p95 (هدف ۵۰۰ms)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(nobatyar_http_request_duration_seconds_bucket{route!~\".*/notifications/stream\"}[5m])))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4, "type": "timeseries", "title": "قیف رزرو: جستجو → رزرو → پرداخت",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "max(nobatyar_business_last_hour{event=\"doctor_search\"})", "legendFormat": "جستجو", "refId": "A" },
        { "expr": "max(nobatyar_business_last_hour{event=\"booking_created\"})", "legendFormat": "رزرو", "refId": "B" },
        { "expr": "max(nobatyar_business_last_hour{event=\"payment_paid\"})", "legendFormat": "پرداخت", "refId": "C" }
      ]
    },
    {
      "id": 5, "type": "stat", "title": "قدیمیترین رویداد Outbox (ثانیه)",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "targets": [{ "expr": "max(nobatyar_outbox_oldest_pending_seconds)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "amber", "value": 300 }, { "color": "red", "value": 600 }] } } }
    },
    {
      "id": 6, "type": "logs", "title": "لاگها (بدون داده سلامت)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{job=~\".*\"}", "refId": "A" }],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true }
    },
    {
      "id": 7, "type": "traces", "title": "Traceها (Tempo)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{ "refId": "A" }]
    }
  ]
}
