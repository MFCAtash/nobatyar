# نوبتیار — نمونه‌ی .env  (کپی به .env؛ هرگز commit نکنید)
# کلیدهای رمزنگاری/JWT/OTP را با این دستور بسازید و اینجا بگذارید:
#   pnpm --filter @nobatyar/api gen:keys
# FIELD_KEYS=...  FIELD_KEY_ACTIVE=1  BLIND_INDEX_KEY=...  JWT_ACCESS_SECRET=...  OTP_SECRET=...

# ── Postgres ──
POSTGRES_USER=nobatyar_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nobatyar
APP_DB_USER=nobatyar_app
APP_DB_PASSWORD=change-me-too
DATABASE_URL=postgresql://nobatyar_owner:change-me@127.0.0.1:5432/nobatyar      # فقط migrate (مالک)
APP_DATABASE_URL=postgresql://nobatyar_app:change-me-too@127.0.0.1:5432/nobatyar # API (بدون BYPASSRLS)

# ── Redis ──
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379

# ── MinIO / S3 ──
MINIO_ROOT_USER=nobatyar
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=nobatyar-private
MINIO_ENDPOINT=http://127.0.0.1:9000
# آدرسی که مرورگر برای presigned URL می‌بیند (توسعه: همان آدرس لوکال). production: https://<STORAGE_DOMAIN>
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# CSP ی وب (build/dev): همان مبدأ ی بالا — بدون آن آپلود در مرورگر مسدود می‌شود
STORAGE_PUBLIC_URL=http://127.0.0.1:9000

# ── API ──
API_PORT=3000
CORS_ORIGINS=http://localhost:3001
# ⚠️ پشت reverse proxy/load balancer (nginx, Cloudflare, ...) حتماً تعداد hop های مورد اعتماد را بگذارید (معمولاً 1).
# بدون آن، req.ip آدرس proxy است و همه‌ی کاربران یک سطل rate limit مشترک می‌گیرند
# (OTP، triage، و /prescriptions/verify ی داروخانه‌ها). اگر مستقیم به اینترنت وصل است: 0.
# مقدار بیش‌ازحد هم خطرناک است (IP جعلی از X-Forwarded-For پذیرفته می‌شود).
TRUST_PROXY_HOPS=0
# ⚠️ job های زمان‌بندی‌شده (انقضای نوبت/نظر دوم، یادآورها) فقط وقتی true باشد اجرا می‌شود.
# روی «دقیقاً یک یا چند نمونه‌ی مشخص» (worker) true بگذارید؛ در production اگر هیچ نمونه‌ای true نباشد، هیچ job ی اجرا نمی‌شود.
ENABLE_WORKERS=false
SMS_PROVIDER=console

# ── فاز ۷: ویزیت تصویری (LiveKit) ──
# توسعه‌ی محلی: docker compose سرویس livekit را با همین کلیدها بالا می‌آورد.
# راز را طولانی و تصادفی بگیرید (حداقل ۳۲ کاراکتر): openssl rand -base64 36
LIVEKIT_API_KEY=nobatyar-dev
LIVEKIT_API_SECRET=change-me-at-least-32-characters-long-secret
LIVEKIT_URL=ws://localhost:7880         # آدرسی که «مرورگر» وصل می‌شود (در production: wss://)
# LIVEKIT_HTTP_URL=http://livekit:7880  # اختیاری: آدرس داخلی برای API مدیریت اتاق
# LIVEKIT_WEBHOOK_URL=http://host.docker.internal:3000/api/v1/video/webhook
VIDEO_TOKEN_TTL_SEC=600
VIDEO_JOIN_GRACE_MINUTES=15

# ── فاز ۸: SOAP، نسخه، نظر دوم، triage ──
SOAP_EDIT_WINDOW_DAYS=7        # پس از پایان نوبت تا چند روز پیش‌نویس/امضا مجاز است (بعد از آن فقط الحاقیه)
# نسخه/نظر دوم/triage پارامتر env ندارند؛ ثابت‌های سیاستی در prescription-policy.ts و second-opinion-policy.ts هستند.

# ── SSE اعلان‌ها (چند-instance با Redis pub/sub) ── docs/sse-redis.md
SSE_HEARTBEAT_SEC=25            # heartbeat؛ ۵..۵۰ (باید از idle-timeout ی ۶۰ثانیه‌ی proxy/LB کمتر بماند)
SSE_MAX_STREAMS_PER_USER=8      # حداکثر اتصال هم‌زمان یک کاربر روی هر نمونه (تب‌ها)؛ بیشتر ⇒ 429
SSE_MAX_LIFETIME_SEC=900        # عمر هر stream (حداکثر؛ کمتر از اعتبار access token هم می‌شود)؛ سپس کلاینت با Last-Event-ID وصل می‌شود
SSE_REPLAY_MAX=200              # حداکثر اعلانِ بازپخش هنگام reconnect؛ بیشتر ⇒ کلاینت لیست را از REST می‌گیرد

# ── درگاه پرداخت (docs/payment-gateway.md) ──
# توسعه/تست: بدون هیچ تنظیمی درگاه «sandbox» (جعلی، بدون شبکه) استفاده می‌شود.
# PAYMENT_GATEWAY=sandbox
# PAYMENT_SANDBOX_MODE=success          # success | fail | pending — فقط غیر production
# درگاه واقعی آزمایشی (NODE_ENV غیر production):
# PAYMENT_GATEWAY=zarinpal
# ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000   # در sandbox هر UUID ی ۳۶ نویسه‌ای
# ZARINPAL_SANDBOX=true
# PAYMENT_FALLBACK_GATEWAYS=zibal,idpay  # به‌ترتیب؛ فقط وقتی درگاه اصلی «در دسترس نیست»
# ZIBAL_MERCHANT=zibal                   # merchant ی آزمایشی (در production ممنوع)
# IDPAY_API_KEY=...  IDPAY_SANDBOX=true
ALLOWED_CALLBACK_ORIGINS=http://localhost:3001
WEB_ORIGIN=http://localhost:3001
PAYMENT_RECONCILE_AFTER_MIN=15          # پرداخت INITIATED قدیمی‌تر از این را job از درگاه استعلام می‌کند
PAYMENT_RECONCILE_EVERY_SEC=300
PAYMENT_HOLD_MIN=30                     # هنگام شروع پرداخت اسلات تا این مدت نگه داشته می‌شود

# ── تست E2E/بار (فقط غیر production؛ در production اپ بالا نمی‌آید) ──
# E2E_TEST_HOOKS=true       # فعال‌کردن /api/v1/__e2e/* (OTP و پزشک آزمایشی)
# SMS_PROVIDER=memory       # کد OTP در حافظه (لازمه‌ی hook بالا)
# OTP_PER_IP_HOURLY=100000 OTP_PER_PHONE_HOURLY=100000   # فقط برای بار/E2E
# ── Sentry / Web Push (اختیاری) ──
# SENTRY_DSN=  NEXT_PUBLIC_SENTRY_DSN=  SENTRY_TRACES_SAMPLE_RATE=0
# VAPID_PUBLIC_KEY=  VAPID_PRIVATE_KEY=  VAPID_SUBJECT=mailto:you@example.ir   # node scripts/gen-vapid.mjs

# ── استرداد وجه (اختیاری؛ بدون توکن ⇒ استرداد دستی) ──
# ZARINPAL_ACCESS_TOKEN=   ZARINPAL_REFUND_METHOD=PAYA   # docs/refunds-admin.md

# ─── فاز ۱۷ (بک‌اند) ───────────────────────────────────────────────
# ابطال فوری نشست (sid در JWT): true ⇒ توکن بدون sid رد می‌شود. هنگام استقرار اولیه می‌توانید یک عمر access token (۱۵ دقیقه) false بگذارید.
ACCESS_REQUIRE_SID=true
# Redis ی ابطال در دسترس نیست: false (پیش‌فرض) ⇒ ۵۰۳ (fail-closed). true فقط در توسعه؛ در production ممنوع است.
SESSION_CHECK_FAIL_OPEN=false
# تأیید دو نفره‌ی استرداد (Maker/Checker): پیش‌فرض روشن. با ۱ ادمین قفل می‌شوید ⇒ حداقل ۲ ادمین.
REFUND_DUAL_APPROVAL=true
# مبالغ (ریال) کمتر از این بدون تأیید دوم اجرا می‌شوند؛ ۰ = همه تأیید می‌خواهند
REFUND_DUAL_APPROVAL_MIN_RIAL=0
# فاصله‌ی دوره‌ی تحویل Outbox (ms؛ ۱۰۰۰ تا ۶۰۰۰۰)
OUTBOX_RELAY_EVERY_MS=5000

# Passkey / WebAuthn — بهطور خودکار از WEB_ORIGIN استنتاج میشود؛ فقط برای override صریح
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3001

# ورود خودکار دمو (فقط غیر production؛ مسیر استاندارد AuthService)
DEMO_AUTOLOGIN=false
DEMO_ROLE=PATIENT

# ── Feature flagهای ماژولهای ارتقا (M1–M15) ──
# پیشفرض: همگی خاموش. برای روشن کردن، مقدار دقیق `true` بدهید (fail-closed).
# سمت سرور: FF_M1_... / سمت کاربر: NEXT_PUBLIC_FF_M1_...
# FF_M1_PASSKEY_FIRST=false
# FF_M2_STATE_POLICY=false
# FF_M3_SMART_BOOKING=false
# FF_M4_FINANCE_AUTO=false
# FF_M5_NOTIF_ORCHESTRATOR=false
# FF_M6_SMART_FILES=false
# FF_M7_CHAT_ASSIST=false
# FF_M8_VIDEO_SMART=false
# FF_M9_PATIENT_RECORD=false
# FF_M10_TRIAGE_GOV=false
# FF_M11_AUTO_OPS=false
# FF_M12_QUALITY=false
# FF_M13_PRODUCT_ANALYTICS=false
# FF_M14_ECOSYSTEM=false
# FF_M15_WCAG=false
