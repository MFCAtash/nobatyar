{
  "name": "nobatyar",
  "version": "1.0.0",
  "private": true,
  "description": "NobatYar — production-grade Persian RTL digital health platform for intelligent clinical scheduling, secure consultations and patient-centered records",
  "keywords": ["healthtech", "booking", "persian", "rtl", "nestjs", "nextjs", "prisma", "rls"],
  "homepage": "https://github.com/MFCAtash/nobatyar#readme",
  "repository": { "type": "git", "url": "https://github.com/MFCAtash/nobatyar.git" },
  "bugs": { "url": "https://github.com/MFCAtash/nobatyar/issues" },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Mohammad Atash <mohammadatash62@gmail.com>",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "pnpm --filter @nobatyar/api test:int",
    "ci:db": "sh scripts/ci-db-setup.sh",
    "ci:local": "turbo run lint typecheck test build",
    "hooks:install": "sh scripts/install-hooks.sh",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait",
    "e2e": "pnpm --filter @nobatyar/e2e e2e",
    "quality:all": "pnpm -r typecheck && pnpm -r test && pnpm --filter @nobatyar/api openapi:check",
    "quality:mutation": "node scripts/quality-mutation.mjs",
    "quality:visual": "node scripts/quality-visual.mjs",
    "quality:a11y": "node scripts/quality-a11y.mjs",
    "quality:sbom": "node scripts/quality-sbom.mjs",
    "canary:dry": "node scripts/canary-rollout.mjs",
    "canary:apply": "node scripts/canary-rollout.mjs --apply",
    "vapid": "node scripts/gen-vapid.mjs"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/sdk-trace-base": "1.30.1"
    }
  }
}
