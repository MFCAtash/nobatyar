# نوبتیار — نمونه‌ی .env.production (کپی به .env.production؛ هرگز commit نکنید)
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
# رمزها را تصادفی و «URL-safe» بگیرید (داخل connection string می‌آیند):  openssl rand -hex 24
# کلیدهای رمزنگاری/JWT/OTP:  pnpm --filter @nobatyar/api gen:keys   (خروجی را اینجا بگذارید)

# ── دامنه و TLS ──
DOMAIN=example.ir
LIVEKIT_DOMAIN=lk.example.ir          # A/AAAA هر دو دامنه باید به این میزبان اشاره کنند (Caddy گواهی می‌گیرد)
STORAGE_DOMAIN=s3.example.ir          # دامنه‌ی سوم (A/AAAA به همین میزبان): آپلود/دانلود پیوست‌ها (MinIO پشت Caddy)
ACME_EMAIL=ops@example.ir
IMAGE_TAG=local

# ── Postgres ──
POSTGRES_USER=nobatyar_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nobatyar
APP_DB_USER=nobatyar_app
APP_DB_PASSWORD=change-me-too

# ── Redis ──
REDIS_PASSWORD=change-me

# ── کلیدها (gen:keys) ──
FIELD_KEYS=change-me
FIELD_KEY_ACTIVE=1
BLIND_INDEX_KEY=change-me
JWT_ACCESS_SECRET=change-me
OTP_SECRET=change-me

# ── پیامک ──
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=change-me
KAVENEGAR_TEMPLATE=change-me

# ── ذخیره‌ساز فایل (MinIO) ──
# root فقط برای job ی minio-init (ساخت bucket/کاربر)؛ API فقط «کاربر app» محدود به همین bucket را می‌بیند.
MINIO_ROOT_USER=change-me-root-user
MINIO_ROOT_PASSWORD=change-me           # openssl rand -hex 24  (URL-safe)
MINIO_APP_USER=nobatyar_app_storage     # باید غیر از MINIO_ROOT_USER باشد
MINIO_APP_PASSWORD=change-me-too        # openssl rand -hex 24
# MINIO_BUCKET=nobatyar-private

# ── LiveKit ──
LIVEKIT_API_KEY=nobatyar-prod
LIVEKIT_API_SECRET=change-me-at-least-32-characters-long-secret

# ── پرداخت (docs/payment-gateway.md) ──
# ⚠️ fail-closed: در production اگر هر flag سندباکس "true" باشد، PAYMENT_GATEWAY=sandbox باشد، مشخصات درگاه اصلی ناقص باشد،
#    merchant ی آزمایشی Zibal باشد یا ALLOWED_CALLBACK_ORIGINS غیر https باشد، API «بالا نمی‌آید».
PAYMENT_GATEWAY=zarinpal                 # zarinpal | zibal | idpay  (الزامی)
ZARINPAL_MERCHANT_ID=change-me           # UUID ی ۳۶ نویسه‌ای پنل زرین‌پال
ZARINPAL_SANDBOX=false
# جایگزین‌ها (اختیاری، به‌ترتیب): وقتی درگاه اصلی قطع بود به اولین جایگزینِ سالم می‌رود
# PAYMENT_FALLBACK_GATEWAYS=zibal,idpay
# ZIBAL_MERCHANT=change-me
ZIBAL_SANDBOX=false
# IDPAY_API_KEY=change-me
IDPAY_SANDBOX=false
PAYMENT_RECONCILE_AFTER_MIN=15
PAYMENT_RECONCILE_EVERY_SEC=300
PAYMENT_HOLD_MIN=30

# ── مانیتورینگ و Web Push (اختیاری؛ خالی = خاموش) ──
# Sentry: همیشه با scrubbing (بدنه‌ی درخواست و هر فیلد پزشکی/هویتی حذف می‌شود؛ docs/monitoring-pwa.md)
# SENTRY_DSN=https://<key>@<host>/<project>
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<host>/<project>     # سمت مرورگر (build-arg)
# Web Push — کلیدها: node scripts/gen-vapid.mjs  (هر سه با هم یا هیچ‌کدام)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@your-domain.ir

# ── SSE ──
SSE_HEARTBEAT_SEC=25

# ── استرداد وجه زرین‌پال (اختیاری؛ بدون توکن ⇒ MANUAL) ──
# ZARINPAL_ACCESS_TOKEN=
# ZARINPAL_REFUND_METHOD=PAYA

# ── پایش و پشتیبان‌گیری (docs/runbooks/) ──
METRICS_TOKEN=change-me-openssl-rand-hex-24      # همان مقدار در infra/monitoring/metrics_token
# ACCESS_LOG=true
# BACKUP_AGE_RECIPIENT=age1...                   # کلید «عمومی» age؛ کلید خصوصی را آفلاین نگه دارید
# BACKUP_KEEP_DAYS=14
# BACKUP_PING_URL=https://hc-ping.com/<uuid>     # dead-man's switch: اگر پشتیبان نیامد هشدار

# ─── فاز ۱۷ ───
ACCESS_REQUIRE_SID=true
REFUND_DUAL_APPROVAL=true
REFUND_DUAL_APPROVAL_MIN_RIAL=0
OUTBOX_RELAY_EVERY_MS=5000

# Passkey / WebAuthn — با دامنه واقعی پر شود (یا از WEB_ORIGIN استنتاج میشود)
WEBAUTHN_RP_ID=${DOMAIN}
WEBAUTHN_ORIGIN=https://${DOMAIN}
