{
  "name": "@nobatyar/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.storybook.json",
    "lint": "pnpm tokens:check && pnpm gen:api:check && eslint src",
    "test": "vitest run",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "gen:api": "node scripts/gen-api-types.mjs",
    "gen:api:check": "node scripts/gen-api-types.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.1.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@nobatyar/shared": "workspace:*",
    "@sentry/browser": "^8.30.0",
    "@simplewebauthn/browser": "10.0.0",
    "@tanstack/react-query": "^5.59.0",
    "livekit-client": "^2.5.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.4.0",
    "@storybook/addon-essentials": "^8.4.0",
    "@storybook/nextjs": "^8.4.0",
    "@storybook/react": "^8.4.0",
    "@types/node": "^20.16.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.12.0",
    "storybook": "^8.4.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  }
}
