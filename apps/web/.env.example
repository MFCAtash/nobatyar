# آدرس API (فقط سمت سرور Next برای پروکسی /api/v1)
API_URL=http://localhost:3000

# فاز ۷ — آدرس عمومی LiveKit برای CSP مرورگر (باید با LIVEKIT_URL سمت API یکی باشد)
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# طول کد OTP برای ارسال خودکار در فرم ورود؛ باید با OTP_LENGTH ی API (۶ تا ۸) یکی باشد
NEXT_PUBLIC_OTP_LENGTH=6
